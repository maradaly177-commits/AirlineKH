# Frontend API Configuration
# Copy this file to .env and adjust values for your environment

# Option 1: Khi dùng Proxy (khuyên dùng) - Frontend trên port 8000 như Backend
# VITE_API_BASE_URL=/api

# Option 2: Khi Frontend trên port khác (5173)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# AI Chat Configuration
# Set to "true" to use mock AI responses (for development without backend)
# Set to "false" to use real backend AI endpoint
VITE_USE_AI_MOCK=false
